# Copy this file to .env and fill in at least one key to turn on the LLM NLP
# tier (Voice Intake, and the LLM extraction tier in layers/nlp_llm.py).
# Leave PULSE_NLP_MODE=lexicon, or delete this file entirely, to run PULSE
# fully offline on the deterministic lexicon matcher — nothing here is
# required for the app to start.
#
# Two independent providers, tried in order (Gemini, then Groq) — set one or
# both. Both have a free tier: Gemini via https://aistudio.google.com,
# Groq via https://console.groq.com.

GEMINI_API_KEY=
GROQ_API_KEY=

# lexicon (default, offline, no key needed) | llm (needs a key above)
PULSE_NLP_MODE=llm

PULSE_GEMINI_MODEL=gemini-3.6-flash
PULSE_GROQ_MODEL=openai/gpt-oss-120b
PULSE_NLP_TIMEOUT=12.0

# Bearer token every write endpoint (intake, decide, admit, medications,
# ward status, ...) requires via the X-PULSE-Token header — see
# backend/auth.py for the DPDP Act 2023 basis. Reads (the board, audit,
# history) stay open. Change this before any real deployment; the demo
# falls back to "pulse-demo-2026" if this is left blank, so the app still
# runs out of the box but is never protected by an unknown value.
PULSE_API_TOKEN=pulse-demo-2026

# Must match PULSE_API_TOKEN above — read by the frontend so it can send
# the header automatically. NEXT_PUBLIC_* is compiled into the client
# bundle, so this is only ever the same demo-scoped value, never a secret.
NEXT_PUBLIC_API_TOKEN=pulse-demo-2026
